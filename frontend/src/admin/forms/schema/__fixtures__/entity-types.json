              "default": null,
              "title": "English"
            }
          },
          "required": ["ru"],
          "title": "Текст на трёх языках",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Editable fields of a media file, as the admin card shows them (GET /admin/entity-types).\n\nSaved with PATCH /admin/media/{id} (`MediaUpdate`); a test keeps the two in step.",
