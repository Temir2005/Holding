    "schema": {
      "$defs": {
        "LocalizedText": {
          "description": "A localized string inside section data and other JSONB documents.",
          "properties": {
            "ru": {
              "title": "Русский",
              "type": "string"
            },
            "kk": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Қазақша"
