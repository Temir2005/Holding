# Env:
#   PORT          port to listen on (Railway sets it)
#   API_UPSTREAM  backend base URL, e.g. http://backend.railway.internal:8000
#   SITE_INDEXING "true" opens the site to search engines: robots.txt allows crawling and
#                 points at /sitemap.xml, no X-Robots-Tag. Anything else (default "false")
#                 keeps it out: robots.txt disallows everything, every response says noindex.
{
	admin off
	auto_https off
	servers {
		# Railway's edge proxy connects from a private or CGNAT address and sets
		# X-Real-IP to the client address it saw, overwriting any value the client sent.
		# X-Forwarded-For is not usable here: Railway's edge runs on CDN77, and the
		# rightmost entry is a CDN77 hop, so every visitor would look like a few
		# shared addresses. Trust only the direct private hop and read X-Real-IP.
		trusted_proxies static private_ranges 100.64.0.0/10
		client_ip_headers X-Real-IP
	}
}

:{$PORT:8080} {
	encode zstd gzip

	# Search engines: only the exact value "true" opens the site (unset = closed).
	@indexing expression `{env.SITE_INDEXING} == 'true'`
	@hidden expression `{env.SITE_INDEXING} != 'true'`
	header @hidden X-Robots-Tag "noindex, nofollow"

	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		# The site is served over https only (Railway terminates TLS in front of Caddy).
		respond @indexing <<TXT
			User-agent: *
			Allow: /

			Sitemap: https://{http.request.host}/sitemap.xml

			TXT 200
		respond <<TXT
			User-agent: *
			Disallow: /

			TXT 200
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM} {
			header_up Host {upstream_hostport}
			# Give the backend exactly one address: the client as resolved above.
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# SPA: unknown paths fall back to index.html, React Router takes it from there.
		try_files {path} /index.html
		file_server
	}
}
