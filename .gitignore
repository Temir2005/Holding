# env
.env
.venv/
venv/

# python
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage

# node
node_modules/
dist/
*.tsbuildinfo
# Vite's dependency cache, rebuilt on every start
.vite/
# Playwright output and layout screenshots (make e2e)
frontend/test-results/
frontend/playwright-report/
frontend/e2e/screenshots/

# os / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local demo stock photos (make demo-photos): never committed
backend/seed/photos/

# Design materials travel as a separate archive, not in git: candidate fonts of the
# prototypes (restored by design/tools/fonts.sh), screenshots and recordings. Prototype code,
# notes (*.md) and tools stay tracked.
design/concepts/_shared/fonts/
design/concepts/**/shots/
design/stage-*/**/*.png
design/stage-*/**/*.jpg
design/stage-*/**/*.jpeg
design/stage-*/**/*.webm
design/tools/*.png

# Lighthouse reports (design/tools/lighthouse.sh): regenerated, only the summary is committed
design/**/lighthouse/*.report.*
