# --- Postgres ---
POSTGRES_USER=megasmart
POSTGRES_PASSWORD=megasmart
POSTGRES_DB=megasmart
# Host port (5432 is often taken by a local Postgres)
POSTGRES_HOST_PORT=5433

# --- MinIO / S3 ---
S3_ACCESS_KEY=megasmart
S3_SECRET_KEY=megasmart-secret
S3_BUCKET=megasmart-media
S3_REGION=us-east-1
# Endpoint the backend uses inside the docker network
S3_ENDPOINT_URL=http://minio:9000
# Base URL the browser uses to load images
S3_PUBLIC_URL=http://localhost:9000
# Host in presigned upload links (the browser PUTs files there). Empty = S3_PUBLIC_URL
S3_PRESIGN_ENDPOINT_URL=

# --- Backend ---
# Poll for file changes so uvicorn --reload works in Docker on macOS
WATCHFILES_FORCE_POLLING=true
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://megasmart:megasmart@postgres:5432/megasmart
TEST_DATABASE_URL=postgresql+asyncpg://megasmart:megasmart@postgres:5432/megasmart_test
CORS_ORIGINS=http://localhost:5173
# Salt for hashing lead IPs; change in production
LEAD_IP_SALT=change-me
LEAD_RATE_LIMIT_PER_MINUTE=5
# Admin JWT (stage 8)
JWT_SECRET=change-me

# --- Frontend ---
# Poll for file changes: needed for hot reload in Docker on macOS
VITE_USE_POLLING=true
VITE_API_PROXY_TARGET=http://backend:8000
